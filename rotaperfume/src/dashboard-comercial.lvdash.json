{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs mensais",
      "queryLines": [
        "SELECT  \n",
        "    MAKE_DATE(ano, mes, 1)                       AS data_ref,  \n",
        "    ano, mes,  \n",
        "    CAST(ano * 100 + mes AS INT)                AS ano_mes_order,  \n",
        "    SUM(receita)                                 AS receita,  \n",
        "    SUM(margem)                                  AS margem,  \n",
        "    COUNT(DISTINCT pedido_id)                    AS pedidos_unicos,  \n",
        "    SUM(receita) / NULLIF(COUNT(DISTINCT pedido_id), 0) AS ticket_medio,  \n",
        "    100.0 * SUM(margem) / NULLIF(SUM(receita), 0)        AS margem_pct  \n",
        "FROM gold.fato_vendas  \n",
        "GROUP BY ano, mes  \n",
        "ORDER BY ano, mes  \n"
      ]
    },
    {
      "name": "ds_dimensoes",
      "displayName": "Agregacoes por dimensao",
      "queryLines": [
        "SELECT  \n",
        "    canal, segmento, cidade,  \n",
        "    cliente_id, razao_social,  \n",
        "    marca, categoria,  \n",
        "    SUM(quantidade_abs)                          AS quantidade,  \n",
        "    SUM(receita)                                 AS receita,  \n",
        "    SUM(margem)                                  AS margem,  \n",
        "    100.0 * SUM(margem) / NULLIF(SUM(receita), 0) AS margem_pct  \n",
        "FROM gold.fato_vendas  \n",
        "GROUP BY canal, segmento, cidade, cliente_id, razao_social, marca, categoria  \n"
      ]
    },
    {
      "name": "ds_fila_semanal",
      "displayName": "Fila semanal",
      "queryLines": [
        "SELECT ordem, razao_social, cidade, score, faixa, motivo, sugestao, vendedor\n",
        "FROM gold.fila_semanal\n"
      ]
    }
  ],
